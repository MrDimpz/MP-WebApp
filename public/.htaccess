# Proper MIME types for video, audio, font, and image assets on Hostinger/Apache
AddType video/mp4 .mp4
AddType video/webm .webm
AddType video/ogg .ogv
AddType image/svg+xml .svg
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp
AddType text/plain .txt
AddType application/xml .xml

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Enable byte-range streaming and long-lived caching for media & static images
  <FilesMatch "\.(mp4|webm|ogv|png|jpg|jpeg|webp|gif|svg|ico|woff|woff2)$">
    Header set Accept-Ranges bytes
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache content-hashed JS/CSS chunks aggressively for repeat page loads
  <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]{6,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Never cache HTML, PHP, or fallback deterministic bundle filenames (must override hashed rule above)
  <FilesMatch "^(index\.html|index-latest\.(js|css)|.*\.php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Fresh crawlability for robots.txt, sitemap.xml, llms.txt
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /socket.io/* requests to /api/relay.php so Socket.IO v4 HTTP polling works natively on HTML/PHP hosts
  RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
  RewriteRule ^socket\.io/(.*)$ /api/relay.php?route=socket.io [QSA,L]

  # Route /api/* requests to /api/relay.php on Apache/Hostinger HTML hosting
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ /api/relay.php?route=$1 [QSA,L]

  # Always serve the latest compiled main JS and CSS bundles even if a browser cached an older index.html hash
  RewriteCond %{REQUEST_URI} !^/assets/index-latest\.js$ [NC]
  RewriteRule ^assets/index-[A-Za-z0-9_-]+\.js$ /assets/index-latest.js [L]

  RewriteCond %{REQUEST_URI} !^/assets/index-latest\.css$ [NC]
  RewriteRule ^assets/index-[A-Za-z0-9_-]+\.css$ /assets/index-latest.css [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
