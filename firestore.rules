rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'Phreakfrog@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'phreakfrog@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidLeaderboardShape(data) {
      let keys = [
        'userId',
        'displayName',
        'gameId',
        'puzzleId',
        'puzzleTitle',
        'score',
        'metricLabel',
        'subMetricLabel',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 64 && data.userId.matches('^[a-zA-Z0-9_-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.gameId is string && data.gameId in ['crossword', 'rebus', 'squared', 'thematix', 'destack', 'unolingo', 'wikirec', 'wikicon', 'mpsearch', 'mpdifference', 'mpcolossal', 'tekscodle', 'wordhunt']
        && data.puzzleId is string && data.puzzleId.size() >= 1 && data.puzzleId.size() <= 64 && data.puzzleId.matches('^[a-zA-Z0-9_-]+$')
        && data.puzzleTitle is string && data.puzzleTitle.size() >= 1 && data.puzzleTitle.size() <= 100
        && data.score is int && data.score >= 0 && data.score <= 1000000
        && data.metricLabel is string && data.metricLabel.size() >= 1 && data.metricLabel.size() <= 60
        && data.subMetricLabel is string && data.subMetricLabel.size() >= 1 && data.subMetricLabel.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHighScoreShape(data) {
      let keys = [
        'userId',
        'displayName',
        'puzzleId',
        'mode',
        'score',
        'wordsFound',
        'totalWords',
        'bonusWordsCount',
        'foundFeatured',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 64 && data.userId.matches('^[a-zA-Z0-9_-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.puzzleId is string && data.puzzleId.size() >= 1 && data.puzzleId.size() <= 64 && data.puzzleId.matches('^[a-zA-Z0-9_-]+$')
        && data.mode is string && data.mode in ['express-3x3', 'daily-4x4', 'royal-5x5']
        && data.score is int && data.score >= 0 && data.score <= 100000
        && data.wordsFound is int && data.wordsFound >= 0 && data.wordsFound <= 500
        && data.totalWords is int && data.totalWords >= 1 && data.totalWords <= 500
        && data.wordsFound <= data.totalWords
        && data.bonusWordsCount is int && data.bonusWordsCount >= 0 && data.bonusWordsCount <= 500
        && data.foundFeatured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRegisteredUserShape(data) {
      let keys = [
        'userId',
        'displayName',
        'tiktokConnected',
        'linkedTikTokHandle',
        'authProvider',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.tiktokConnected is bool
        && data.linkedTikTokHandle is string && data.linkedTikTokHandle.size() <= 40 && data.linkedTikTokHandle.matches('^(@[a-zA-Z0-9_.-]+)?$')
        && data.authProvider is string && data.authProvider in ['email', 'google', 'site']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOverlaySyncShape(data) {
      let keys = [
        'gameId',
        'channel',
        'streamer',
        'hostSessionId',
        'seq',
        'stateHash',
        'state',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.gameId is string && data.gameId in ['crowdle', 'destackint', 'mpsearchint', 'squaredint', 'wikicon', 'wikirec', 'lexi', 'inkstream', 'mpwh', 'wbr', 'tow']
        && data.channel is string && data.channel.size() <= 64 && data.channel.matches('^[a-z0-9_-]*$')
        && data.streamer is string && data.streamer.size() <= 80 && data.streamer.matches('^[a-z0-9_.-]*$')
        && data.hostSessionId is string && data.hostSessionId.size() >= 1 && data.hostSessionId.size() <= 64 && data.hostSessionId.matches('^[a-zA-Z0-9_-]+$')
        && data.seq is int && data.seq >= 1 && data.seq <= 100000000
        && data.stateHash is string && data.stateHash.size() >= 1 && data.stateHash.size() <= 64 && data.stateHash.matches('^[a-zA-Z0-9:_-]+$')
        && data.state is map && data.state.keys().size() >= 1 && data.state.keys().size() <= 100
        && data.updatedAt is timestamp;
    }

    function isValidUserProfileShape(data) {
      let keys = [
        'userId',
        'displayName',
        'linkedTikTokHandle',
        'preferredLanguage',
        'darkMode',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.linkedTikTokHandle is string && data.linkedTikTokHandle.size() <= 40 && data.linkedTikTokHandle.matches('^(@[a-zA-Z0-9_.-]+)?$')
        && data.preferredLanguage is string && data.preferredLanguage in ['en', 'es', 'fr', 'de', 'it', 'pt', 'tl']
        && data.darkMode is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProgressBucketShape(data) {
      let keys = [
        'userId',
        'bucketId',
        'payload',
        'createdAt',
        'updatedAt'
      ];
      return data.keys().hasAll(keys)
        && data.keys().hasOnly(keys)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_-]+$')
        && data.bucketId is string && data.bucketId in [
          'daily_streaks',
          'interactive_scores',
          'crossword',
          'rebus',
          'squared',
          'thematix',
          'destack',
          'unolingo',
          'mpsearch',
          'mpdifference',
          'mpcolossal',
          'tekscodle',
          'wordhunt'
        ]
        && data.payload is map && data.payload.keys().size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Unified Solo Games Leaderboard (publicly readable by visitors; contains no PII)
    match /leaderboard/{entryId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && isValidDocId(entryId)
        && isValidLeaderboardShape(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidDocId(entryId)
        && isValidLeaderboardShape(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().gameId == existing().gameId
        && incoming().puzzleId == existing().puzzleId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'puzzleTitle',
          'score',
          'metricLabel',
          'subMetricLabel',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Squared Detailed High Scores (publicly readable by visitors; contains no PII)
    match /highscores/{scoreId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && isValidDocId(scoreId)
        && isValidHighScoreShape(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidDocId(scoreId)
        && isValidHighScoreShape(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().puzzleId == existing().puzzleId
        && incoming().mode == existing().mode
        && incoming().totalWords == existing().totalWords
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'score',
          'wordsFound',
          'bonusWordsCount',
          'foundFeatured',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Non-PII Registered Users Directory (stores only public displayName & TikTok connection state; zero email/PII)
    match /registeredUsers/{userId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn()
        && isValidDocId(userId)
        && isOwner(userId)
        && isValidRegisteredUserShape(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidDocId(userId)
        && isOwner(userId)
        && isValidRegisteredUserShape(incoming())
        && incoming().userId == existing().userId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'tiktokConnected',
          'linkedTikTokHandle',
          'authProvider',
          'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // Owner-Only Authenticated User Profile & Cross-Session Preferences
    match /users/{userId} {
      allow get: if isValidDocId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidDocId(userId)
        && isOwner(userId)
        && isValidUserProfileShape(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidDocId(userId)
        && isOwner(userId)
        && isValidUserProfileShape(incoming())
        && incoming().userId == existing().userId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'linkedTikTokHandle',
          'preferredLanguage',
          'darkMode',
          'updatedAt'
        ]);

      allow delete: if isValidDocId(userId) && (isOwner(userId) || isAdmin());

      // Master-Gated Cross-Session Game Progress Subcollection
      match /progress/{bucketId} {
        allow get: if isValidDocId(userId)
          && isValidDocId(bucketId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == userId;

        allow list: if isSignedIn()
          && isOwner(userId)
          && existing().userId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidDocId(userId)
          && isValidDocId(bucketId)
          && isOwner(userId)
          && isValidUserProgressBucketShape(incoming())
          && incoming().userId == request.auth.uid
          && incoming().bucketId == bucketId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow update: if isSignedIn()
          && isValidDocId(userId)
          && isValidDocId(bucketId)
          && isOwner(userId)
          && isValidUserProgressBucketShape(incoming())
          && existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && incoming().bucketId == existing().bucketId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'payload',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;

        allow delete: if isValidDocId(userId)
          && isValidDocId(bucketId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.userId == userId;
      }
    }

    // Real-time TikTok LIVE Studio Browser Source Overlay Sync (no PII; exact-key get only, list disabled)
    match /overlaySessions/{sessionKey} {
      allow get: if isValidDocId(sessionKey);
      allow list: if false;

      allow create: if isValidDocId(sessionKey)
        && isValidOverlaySyncShape(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isValidDocId(sessionKey)
        && isValidOverlaySyncShape(incoming())
        && incoming().gameId == existing().gameId
        && (incoming().hostSessionId != existing().hostSessionId || incoming().seq >= existing().seq)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'channel',
          'streamer',
          'hostSessionId',
          'seq',
          'stateHash',
          'state',
          'updatedAt'
        ])
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }
  }
}
